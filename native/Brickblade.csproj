<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="GameOrder.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Brickblade</AssemblyName>
    <RootNamespace>Brickblade</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- a double or bool compared with null is always false (or true): the JS's
         undefined is NaN or a default here, never null -->
    <WarningsAsErrors>CS0472;CS0464</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- the port keeps the JS names and shapes; these warnings are about that, not bugs -->
    <NoWarn>CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS8981;CS1717;CS0108;CS0659;CS0661</NoWarn>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
    <PackageReference Include="LibTessDotNet" Version="1.1.15" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
    <!-- the game's files go to the compiler in JS order, so their static
         initialisers run in the order the browser ran the script (GameOrder.props);
         a file not listed there yet still compiles, last -->
    <Compile Remove="src/Game/**" />
    <Compile Include="@(GameOrdered)" />
    <Compile Include="src/Game/**/*.cs" Exclude="@(GameOrdered)" />
    <EmbeddedResource Include="assets/**/*" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- the game's own page: its stylesheet and its screens (the script is the C#) -->
    <EmbeddedResource Include="../lego-survival.html" LogicalName="page.html" />
  </ItemGroup>
</Project>
